# Shared native_sim development image (outline; not yet tested).
# Build from the repository root:
#   podman build -f sim/podman/Containerfile -t zeppelin-native-sim .
FROM docker.io/library/ubuntu:24.04

# Ubuntu 24.04 supplies Python 3.12 and the required CMake version.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git cmake ninja-build gperf ccache \
        build-essential device-tree-compiler pkg-config \
        python3-dev python3-pip python3-venv python3-tk \
        wget xz-utils file libsdl2-dev libmagic1 \
    && if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        apt-get install -y --no-install-recommends gcc-multilib g++-multilib; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# Keep the container's Python environment separate from the mounted host venv.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir west

# Cache the shared Zephyr sources, modules, and Python dependencies in the image.
# The manifest selects the Zephyr revision; rebuild when it changes.
# Only this stub checkout is copied. Mount the real repository over it at runtime.
WORKDIR /workspace/zeppelin
COPY west.yml ./west.yml
COPY scripts/ ./scripts/
RUN west init -l . \
    && west update \
    && west packages pip --install -- --no-cache-dir

# native_sim uses Linux's GCC/G++, so no embedded Zephyr SDK is needed here.
ENV ZEPHYR_BASE=/workspace/zephyr
ENV ZEPHYR_TOOLCHAIN_VARIANT=host

# Suggested runtime target: native_sim/native/64 (also usable on ARM64 hosts).
# amd64 images additionally support the default 32-bit native_sim target.
# No firmware is built into this image; select an app with west build at runtime.
CMD ["/bin/bash"]
